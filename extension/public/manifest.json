{
  "manifest_version": 3,
  "name": "SpoilerScroll",
  "version": "0.1.0",
  "description": "Flags posts and headlines that look like pages already in your browser history.",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "scripting",
    "activeTab"
  ],
  "optional_permissions": [
    "history"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SpoilerScroll"
  },
  "incognito": "not_allowed",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "key": ""
}
